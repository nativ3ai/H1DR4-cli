# Provider configuration (default is local Ollama)
H1DR4_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=huihui_ai/qwen2.5-coder-abliterate:7b
# OLLAMA_KEEP_ALIVE=5m

# Optional remote provider configuration
# GROK_API_KEY=your_grok_api_key_here
# GROK_BASE_URL=https://api.x.ai/v1

# Live search configuration
# H1DR4_LIVE_SEARCH=on
# H1DR4_MAX_SOURCES=5
# H1DR4_CITATIONS=on
# LIVESEARCH_CACHE_TTL=86400000
# H1DR4_MAX_HISTORY=20
# H1DR4_MAX_HISTORY_TOKENS=4000
# H1DR4_DEBUG=false
# H1DR4_DEBUG_PERF=false

# Optional:
# OSINT_TOKEN=your_osint_token
